    "Spin Off as New Score turns any version, or a branch's latest version, into a score of its own in your library with a fresh history." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als neue Partitur abspalten macht aus jeder Version oder der neuesten Version eines Zweigs eine eigene Partitur in deiner Bibliothek mit frischem Verlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separar como nueva partitura convierte cualquier versión, o la última versión de una rama, en una partitura propia en tu biblioteca con un historial nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détacher comme nouvelle partition transforme n'importe quelle version, ou la dernière version d'une branche, en une partition à part dans votre bibliothèque avec un historique neuf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separa come nuovo spartito trasforma qualsiasi versione, o l'ultima versione di un ramo, in uno spartito a sé nella tua libreria con una cronologia nuova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「新しい楽譜として分離」は、任意のバージョン、またはブランチの最新バージョンを、新しい履歴を持つ独立した楽譜としてライブラリに作ります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separar como nova partitura transforma qualquer versão, ou a versão mais recente de um ramo, numa partitura própria na sua biblioteca com um histórico novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela av som ny not gör vilken version som helst, eller en grens senaste version, till en egen not i ditt bibliotek med en ny historik."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“分出为新乐谱”把任何版本或某分支的最新版本变成资料库中一份独立的乐谱,带有全新的历史。"
          }
        }
      }
    },
