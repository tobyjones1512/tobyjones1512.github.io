    "Import Score does nothing or shows a file greyed out: choose All Files in the Files browser, or drag the file onto the window." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partitur importieren tut nichts oder zeigt eine Datei ausgegraut: Wähle Alle Dateien im Dateien-Browser oder ziehe die Datei auf das Fenster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importar partitura no hace nada o muestra un archivo atenuado: elige Todos los archivos en el navegador de Archivos, o arrastra el archivo a la ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importer une partition ne fait rien ou affiche un fichier grisé : choisissez Tous les fichiers dans le navigateur Fichiers, ou faites glisser le fichier sur la fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa spartito non fa nulla o mostra un file in grigio: scegli Tutti i file nel browser File, oppure trascina il file sulla finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
