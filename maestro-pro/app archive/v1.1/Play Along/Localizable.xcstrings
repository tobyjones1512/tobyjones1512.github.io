    "A wobble or a different note starts the time again. Goals are counted for you, so you can try to beat them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wackeln oder ein anderer Ton startet die Zeit neu. Ziele werden für dich gezählt, sodass du versuchen kannst, sie zu schlagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vacilación o una nota distinta reinicia el tiempo. Los objetivos se cuentan por ti, así que puedes intentar superarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tremblement ou une autre note fait repartir le temps. Les objectifs sont comptés pour vous, vous pouvez donc essayer de les battre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tremolio o una nota diversa fa ripartire il tempo. Gli obiettivi vengono contati per te, così puoi provare a batterli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぐらついたり別の音になったりすると、時間はやり直しです。目標は数えられるので、更新を狙えます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma oscilação ou uma nota diferente reinicia o tempo. Os objetivos são contados por si, para que possa tentar superá-los."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vickning eller en annan ton startar om tiden. Mål räknas åt dig, så du kan försöka slå dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晃动或换成别的音会让计时重新开始。目标会替你计数,所以你可以尝试打破它们。"
          }
        }
      }
    },
