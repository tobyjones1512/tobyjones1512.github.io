    "Bars %lld to %lld chosen. Copy, Cut, Duplicate or Delete them, or Paste after them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takte %1$lld bis %2$lld gewählt. Kopiere, schneide aus, dupliziere oder lösche sie, oder füge danach etwas ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compases %1$lld a %2$lld seleccionados. Cópialos, córtalos, duplícalos o elimínalos, o pega algo después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesures %1$lld à %2$lld choisies. Copiez, coupez, dupliquez ou supprimez-les, ou collez après elles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battute da %1$lld a %2$lld selezionate. Copiale, tagliale, duplicale o eliminale, oppure incolla qualcosa dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 〜 %2$lld 小節を選択中。コピー、カット、複製、削除ができ、その後ろに貼り付けもできます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compassos %1$lld a %2$lld selecionados. Copie, corte, duplique ou elimine-os, ou cole algo depois."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takt %1$lld till %2$lld valda. Kopiera, klipp ut, duplicera eller ta bort dem, eller klistra in något efter dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已选择第 %1$lld 至 %2$lld 小节。可复制、剪切、复制副本或删除,也可在其后粘贴内容。"
          }
        }
      }
    },
    "Bars %lld to %lld chosen. Delete them, or tap one bar for repeat signs." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bars %1$lld to %2$lld chosen. Delete them, or tap one bar for repeat signs."
          }
        }
      }
    },
    "Bars Before Bar 1 adds empty bars to the start, to count yourself in." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Takte vor Takt 1“ fügt am Anfang leere Takte zum Einzählen hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Compases antes del compás 1» añade compases vacíos al principio para contar antes de empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Mesures avant la mesure 1 » ajoute des mesures vides au début, pour compter l'entrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Battute prima della battuta 1» aggiunge battute vuote all'inizio, per fare il conteggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「1小節目の前の小節数」は、カウントインのために先頭に空の小節を追加します。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Compassos antes do compasso 1» acrescenta compassos vazios no início, para contares antes de entrar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Takter före takt 1” lägger till tomma takter i början, så att du kan räkna in dig."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“第 1 小节之前的小节数”会在开头添加空小节，供你数拍进入。"
          }
        }
      }
    },
    "Bars Before Bar 1 adds empty bars to the start; the backing track starts with the first of them, from the marker." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Takte vor Takt 1“ fügt am Anfang leere Takte hinzu; das Playback beginnt mit dem ersten davon, an der Markierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Compases antes del compás 1» añade compases vacíos al principio; la pista de acompañamiento empieza con el primero de ellos, desde el marcador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Mesures avant la mesure 1 » ajoute des mesures vides au début ; l'accompagnement démarre à la première d'entre elles, depuis le repère."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Battute prima della battuta 1» aggiunge battute vuote all'inizio; la base parte dalla prima di esse, dal segnaposto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「1小節目の前の小節数」は先頭に空の小節を追加します。バッキングトラックはマーカーの位置から、その最初の小節で始まります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Compassos antes do compasso 1» acrescenta compassos vazios no início; o acompanhamento começa no primeiro deles, a partir do marcador."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Takter före takt 1” lägger till tomma takter i början; kompspåret börjar med den första av dem, från markören."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“第 1 小节之前的小节数”会在开头添加空小节；伴奏从其中第一个小节开始，位置在标记处。"
          }
        }
      }
    },
    "Bars changed on only one branch are brought together. Bars changed on both clash. You can roll the merge back from the history." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takte, die nur in einem Zweig geändert wurden, werden zusammengeführt. Takte, die in beiden geändert wurden, kollidieren. Du kannst die Zusammenführung im Verlauf zurücknehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los compases cambiados en una sola rama se unen. Los cambiados en ambas chocan. Puedes deshacer la fusión desde el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mesures modifiées sur une seule branche sont réunies. Celles modifiées sur les deux entrent en conflit. Vous pouvez annuler la fusion depuis l'historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le battute modificate in un solo ramo vengono riunite. Quelle modificate in entrambi sono in conflitto. Puoi annullare l'unione dalla cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片方のブランチだけで変更された小節はまとめられます。両方で変更された小節は競合します。マージは履歴から取り消せます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os compassos alterados apenas num ramo são reunidos. Os alterados em ambos entram em conflito. Podes anular a fusão a partir do histórico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takter som ändrats på bara en gren förs samman. Takter som ändrats på båda krockar. Du kan ångra sammanslagningen från historiken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在一个分支中更改的小节会被合并。两个分支都更改的小节会冲突。你可以在历史记录中撤销合并。"
          }
        }
      }
    },
