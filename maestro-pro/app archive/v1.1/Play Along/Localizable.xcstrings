    "Paper colour tints the page behind the notes, and scanned pages take it too." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Papierfarbe tönt die Seite hinter den Noten, und gescannte Seiten übernehmen sie ebenfalls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El color del papel tiñe la página detrás de las notas, y las páginas escaneadas también lo toman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La couleur du papier teinte la page derrière les notes, et les pages numérisées la prennent aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il colore della carta tinge la pagina dietro le note, e anche le pagine scansionate lo assumono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紙の色は、音符の後ろのページに色を付け、スキャンしたページにも適用されます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cor do papel tinge a página por trás das notas, e as páginas digitalizadas também a assumem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papperets färg tonar sidan bakom tonerna, och skannade sidor får den också."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "纸张颜色会为音符后面的页面着色，扫描的页面同样适用。"
          }
        }
      }
    },
