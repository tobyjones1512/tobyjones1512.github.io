    "Mark bar 1 first, then tap on a downbeat at least a second later." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere zuerst Takt 1, dann tippe mindestens eine Sekunde später auf eine betonte Zählzeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca primero el compás 1 y luego toca un tiempo fuerte al menos un segundo después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez d’abord la mesure 1, puis touchez sur un temps fort au moins une seconde plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segna prima la battuta 1, poi tocca un tempo forte almeno un secondo dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
