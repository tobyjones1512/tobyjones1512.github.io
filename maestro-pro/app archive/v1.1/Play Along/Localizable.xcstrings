    "With a backing track, Shift Backing Track decides whether the backing track moves with the score." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einem Playback entscheidet Playback verschieben, ob das Playback mit der Partitur wandert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un acompañamiento, Transportar acompañamiento decide si el acompañamiento se mueve con la partitura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec un accompagnement, Transposer l'accompagnement décide si celui-ci suit la partition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una base, Sposta base decide se la base si muove con lo spartito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッキングがある場合、「バッキングを移調」はバッキングが楽譜と一緒に動くかを決めます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com um acompanhamento, Transpor acompanhamento decide se o acompanhamento se move com a partitura."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med ett komp avgör Flytta komp om kompet flyttas med noten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有伴奏时,“移动伴奏”决定伴奏是否随乐谱一起移动。"
          }
        }
      }
    },
    "With everything off, only the bar counter and the page turns follow the music." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist alles aus, folgen nur der Taktzähler und das Umblättern der Musik."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con todo desactivado, solo el contador de compases y los cambios de página siguen la música."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout désactivé, seuls le compteur de mesures et les tournes de page suivent la musique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tutto disattivato, solo il contatore di battute e i cambi pagina seguono la musica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてオフにすると、小節カウンタとページめくりだけが音楽に追従します。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com tudo desligado, só o contador de compassos e as viragens de página acompanham a música."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När allt är av följer bara takträknaren och sidvändningarna musiken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部关闭后，只有小节计数和翻页会跟随音乐。"
          }
        }
      }
    },
