    "Words and music in one file. A plain MIDI file counts when it carries words." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text und Musik in einer Datei. Eine einfache MIDI-Datei zählt, wenn sie Text enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letra y música en un solo archivo. Un MIDI simple cuenta si lleva letra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paroles et musique dans un seul fichier. Un fichier MIDI simple compte quand il contient des paroles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testo e musica in un unico file. Un MIDI semplice conta se contiene testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌詞と音楽を1つのファイルに。歌詞を含むプレーンな MIDI も対象です。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letra e música num só ficheiro. Um MIDI simples conta se tiver letra."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sångtext och musik i en fil. En enkel MIDI-fil räknas om den innehåller text."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌词与音乐合在一个文件中。带歌词的普通 MIDI 也算。"
          }
        }
      }
    },
    "Words only; spread across the recording." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Wörter; über die Aufnahme verteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo palabras; repartidas por la grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paroles seules ; réparties sur l’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo parole; distribuite lungo la registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌詞のみ。録音全体に広がります。"
          }
        },
