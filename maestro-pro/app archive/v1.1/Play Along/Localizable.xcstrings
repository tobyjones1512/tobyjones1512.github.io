    "Single keys (like the space bar) only work when you are not typing in a box." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einzelne Tasten (wie die Leertaste) funktionieren nur, wenn du nicht in einem Feld tippst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las teclas sueltas (como la barra espaciadora) solo funcionan cuando no estás escribiendo en un campo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les touches seules (comme la barre d'espace) ne fonctionnent que lorsque vous ne saisissez pas de texte dans un champ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
