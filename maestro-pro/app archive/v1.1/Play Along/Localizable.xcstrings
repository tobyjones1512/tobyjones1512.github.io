    "There is no note after this one to tie to. Add one first, or turn on Free Editing in Options." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dieser Note gibt es keine Note zum Binden. Füge zuerst eine hinzu oder schalte Freies Bearbeiten in den Optionen ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna nota después de esta para ligar. Añade una primero, o activa Edición libre en Opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a pas de note après celle-ci à laquelle la lier. Ajoutez-en une d’abord, ou activez la modification libre dans Options."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'è nessuna nota dopo questa a cui legarla. Aggiungine prima una, oppure attiva Modifica libera in Opzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この音符のあとにタイでつなぐ音符がありません。先に追加するか、オプションで自由編集をオンにしてください。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há nenhuma nota depois desta para ligar. Adicione uma primeiro, ou ative a Edição livre nas Opções."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ingen not efter den här att binda till. Lägg först till en, eller slå på Fri redigering i Alternativ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
