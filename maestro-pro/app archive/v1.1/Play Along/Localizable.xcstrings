    "App Text Size, Bold Text, High Contrast, Larger Playback Controls and Reduce Motion." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Textgröße, Fetter Text, Hoher Kontrast, Größere Wiedergabesteuerung und Bewegung reduzieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño del texto de la app, Texto en negrita, Alto contraste, Controles de reproducción grandes y Reducir movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille du texte de l'app, Texte en gras, Contraste élevé, Commandes de lecture agrandies et Réduire les animations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensione del testo dell'app, Testo in grassetto, Contrasto elevato, Controlli di riproduzione più grandi e Riduci movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの文字サイズ、太字テキスト、コントラストを上げる、大きな再生コントロール、視差効果を減らす。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanho do texto da app, Texto a negrito, Alto contraste, Controlos de reprodução maiores e Reduzir movimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apptextstorlek, Fet text, Hög kontrast, Större uppspelningskontroller och Minska rörelse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 文字大小、粗体文字、高对比度、较大的播放控件和减弱动态效果。"
          }
        }
      }
    },
    "Appearance" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheinungsbild"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apariencia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparence"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外観"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspeto"
          }
        },
        "sv" : {
