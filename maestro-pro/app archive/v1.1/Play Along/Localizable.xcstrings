    "Expand Repeats writes the piece out as it is played, with every repeat, ending and jump as its own bars." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederholungen ausschreiben schreibt das Stück so aus, wie es gespielt wird, mit jeder Wiederholung, Klammer und jedem Sprung als eigenen Takten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplegar repeticiones escribe la pieza tal como se toca, con cada repetición, final y salto como compases propios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Développer les reprises écrit le morceau tel qu'il est joué, avec chaque reprise, fin et saut comme ses propres mesures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espandi ritornelli scrive il brano così come viene suonato, con ogni ritornello, finale e salto come battute proprie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「反復を展開」は曲を実際に演奏される形に書き出し、すべての反復、エンディング、ジャンプがそれぞれの小節になります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expandir repetições escreve a peça tal como é tocada, com cada repetição, final e salto como compassos próprios."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ut repriser skriver ut stycket som det spelas, med varje repris, klammer och hopp som egna takter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
