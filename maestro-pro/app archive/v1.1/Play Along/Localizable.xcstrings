    "Search at the top of the library finds titles. Settings chooses how the library is sorted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche oben in der Bibliothek findet Titel. In den Einstellungen wählst du, wie die Bibliothek sortiert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda de la parte superior de la biblioteca encuentra títulos. Ajustes elige cómo se ordena la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche en haut de la bibliothèque trouve les titres. Les Réglages choisissent le tri de la bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricerca in cima alla libreria trova i titoli. Le Impostazioni scelgono come ordinare la libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリ上部の検索でタイトルを探せます。ライブラリの並び順は「設定」で選びます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pesquisa no topo da biblioteca encontra títulos. As Definições escolhem como a biblioteca é ordenada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sökningen högst upp i biblioteket hittar titlar. Inställningar väljer hur biblioteket sorteras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "资料库顶部的搜索可查找标题。“设置”中可选择资料库的排序方式。"
          }
        }
      }
    },
