    "Brought in %lld versions. Branches that went separate ways are named …-github, to merge." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Versionen übernommen. Zweige, die getrennte Wege gingen, heißen …-github, damit du sie zusammenführen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld versiones incorporadas. Las ramas que divergieron se llaman …-github para que puedas fusionarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld versions importées. Les branches qui ont divergé sont nommées …-github, pour les fusionner."
