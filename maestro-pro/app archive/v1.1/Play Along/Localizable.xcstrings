    "Just the essentials: open a score, rehearse it, set tempo and key. Switch to Advanced for the editors, sync tools, sharing and the rest." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur das Wesentliche: Partitur öffnen, üben, Tempo und Tonart einstellen. Wechsle zu „Erweitert“ für Editoren, Sync-Werkzeuge, Teilen und mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lo esencial: abre una partitura, ensaya, ajusta tempo y tono. Pasa a Avanzado para los editores, la sincronización, compartir y más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'essentiel : ouvrir une partition, la répéter, régler tempo et tonalité. Passez en Avancé pour les éditeurs, les outils de synchronisation, le partage et le reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo l'essenziale: apri uno spartito, prova, imposta metronomo e tonalità. Passa ad Avanzate per editor, strumenti di sincronizzazione, condivisione e altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本だけ：楽譜を開き、練習し、テンポとキーを設定します。エディタ、同期ツール、共有などは「詳細」に切り替えると使えます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o essencial: abre uma partitura, ensaia, define andamento e tonalidade. Muda para Avançado para os editores, ferramentas de sincronização, partilha e mais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara det väsentliga: öppna ett notblad, öva, ställ in tempo och tonart. Växla till Avancerat för redigerare, synkverktyg, delning och mer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只保留基本功能：打开乐谱、排练、设置速度和调。切换到“高级”可使用编辑器、同步工具、分享等更多功能。"
          }
        }
      }
    },
    "Just the essentials: open, play along, change tempo and key." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur das Wesentliche: öffnen, mitspielen, Tempo und Tonart ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lo esencial: abrir, tocar junto, cambiar tempo y tono."
          }
        },
        "fr" : {
