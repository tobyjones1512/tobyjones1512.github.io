    "Plays in time with the score; can be pitch-shifted and have its volume, tempo and pitch edited." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt im Takt mit der Partitur; Tonhöhe lässt sich verschieben, Lautstärke, Tempo und Tonhöhe lassen sich bearbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suena al compás de la partitura; se puede transportar, y se pueden editar volumen, tempo y tono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joue en rythme avec la partition ; peut être transposé et voir son volume, son tempo et sa hauteur modifiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona a tempo con lo spartito; trasponibile, con volume, tempo e intonazione modificabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽譜と同じタイミングで演奏します。移調でき、音量、テンポ、ピッチを編集できます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca ao ritmo da partitura; pode ser transposta, e o volume, o andamento e a altura podem ser editados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar i takt med noten; kan transponeras, och volym, tempo och tonhöjd kan redigeras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与乐谱同步演奏;可移调,音量、速度和音高均可编辑。"
          }
        }
      }
    },
    "Plays the chosen bars over and over, to practise a hard passage." : {
