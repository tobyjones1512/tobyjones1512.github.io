    "Scores that follow you to the note, hands-free page turns, ensemble sync, recording and review. Built for rehearsal, ready for the stage." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partituren, die dir auf die Note folgen, freihändiges Umblättern, Ensemble-Sync, Aufnahme und Rückblick. Gebaut für die Probe, bereit für die Bühne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partituras que te siguen nota a nota, pasar página sin manos, sincronización de conjunto, grabación y revisión. Hecha para ensayar, lista para el escenario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des partitions qui vous suivent à la note près, des pages tournées sans les mains, la synchronisation d'ensemble, l'enregistrement et la revue. Conçu pour la répétition, prêt pour la scène."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spartiti che ti seguono nota per nota, cambio pagina a mani libere, sincronizzazione d'insieme, registrazione e revisione. Pensata per le prove, pronta per il palco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音符ひとつひとつについてくる楽譜、手を使わないページめくり、アンサンブル同期、録音と振り返り。練習のために作られ、本番にも備えます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partituras que te seguem nota a nota, viragem de página sem mãos, sincronização de conjunto, gravação e revisão. Feita para o ensaio, pronta para o palco."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notblad som följer dig ton för ton, handsfree-bläddring, ensemblesynk, inspelning och återblick. Byggt för repetition, redo för scenen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧跟每个音符的乐谱、免手动翻页、合奏同步、录制与回顾。为排练而生，为舞台而备。"
          }
        }
      }
    },
    "Scores, lyrics and recordings with the same name are added together. Swipe to remove a repository." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partituren, Texte und Aufnahmen mit gleichem Namen werden zusammen hinzugefügt. Wische, um ein Repository zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las partituras, letras y grabaciones con el mismo nombre se añaden juntas. Desliza para quitar un repositorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les partitions, paroles et enregistrements portant le même nom sont ajoutés ensemble. Balayez pour retirer un dépôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spartiti, testi e registrazioni con lo stesso nome vengono aggiunti insieme. Scorri per rimuovere un repository."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ名前の楽譜、歌詞、録音はまとめて追加されます。スワイプでリポジトリを取り除きます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partituras, letras e gravações com o mesmo nome são adicionadas em conjunto. Desliza para remover um repositório."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notblad, texter och inspelningar med samma namn läggs till tillsammans. Svep för att ta bort ett arkiv."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同名的乐谱、歌词和录音会一并添加。轻扫可移除仓库。"
          }
        }
      }
    },
