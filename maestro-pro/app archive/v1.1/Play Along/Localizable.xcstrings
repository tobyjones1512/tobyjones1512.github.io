          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャンプ"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltos"
          }
        },
        "sv" : {
