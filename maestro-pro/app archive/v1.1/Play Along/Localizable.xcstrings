    "Search for the song, open its Enhanced (word-timed) lyrics, then tap Use These Lyrics, or download the .lrc file." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche den Song, öffne seine erweiterten (wortgenau getakteten) Texte und tippe dann auf „Diese Texte verwenden“, oder lade die .lrc-Datei herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca la canción, abre su letra mejorada (sincronizada palabra a palabra) y toca Usar esta letra, o descarga el archivo .lrc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cherchez le morceau, ouvrez ses paroles enrichies (synchronisées mot à mot), puis touchez Utiliser ces paroles, ou téléchargez le fichier .lrc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca il brano, apri il suo testo avanzato (sincronizzato parola per parola), poi tocca Usa questo testo, oppure scarica il file .lrc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲を検索し、拡張（単語ごとのタイミング付き）歌詞を開いて、「この歌詞を使う」をタップするか、.lrcファイルをダウンロードします。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquisa a canção, abre a letra melhorada (sincronizada palavra a palavra) e toca em Usar esta letra, ou transfere o ficheiro .lrc."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sök efter låten, öppna dess utökade (ord för ord tidsatta) text och tryck sedan på Använd den här texten, eller hämta .lrc-filen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索歌曲，打开其增强（逐字定时）歌词，然后点按“使用这些歌词”，或下载 .lrc 文件。"
          }
        }
      }
    },
