    "Make the notation bigger or smaller; the bars reflow into more or fewer to a row. Pinch also works." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mache die Notation größer oder kleiner; die Takte werden auf mehr oder weniger pro Zeile umbrochen. Auch Zoomen mit zwei Fingern funktioniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz la notación más grande o más pequeña; los compases se reorganizan en más o menos por fila. También funciona pellizcar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrandissez ou réduisez la notation ; les mesures se répartissent en plus ou moins de mesures par ligne. Le pincement fonctionne aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingrandisci o riduci la notazione; le battute si riorganizzano in più o meno per riga. Funziona anche il pizzico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "譜面を大きく、または小さくします。1行あたりの小節数が増減して組み直されます。ピンチ操作も使えます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta ou diminui a notação; os compassos reorganizam-se em mais ou menos por linha. Também podes usar o gesto de pinça."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör notbilden större eller mindre; takterna omfördelas till fler eller färre per rad. Nyp fungerar också."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大或缩小乐谱；小节会重新排布，每行容纳更多或更少。也可以双指张合缩放。"
          }
        }
      }
    },
