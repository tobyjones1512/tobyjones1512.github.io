    "That licence key isn’t valid." : {

    },
    "That song couldn’t be found on Genius, so its singers couldn’t be matched." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Song wurde auf Genius nicht gefunden, daher konnten seine Sänger nicht zugeordnet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró la canción en Genius, así que no se pudieron emparejar sus cantantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce morceau est introuvable sur Genius, ses chanteurs n’ont donc pas pu être associés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il brano non è stato trovato su Genius, quindi non è stato possibile abbinare i suoi cantanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genius で曲が見つからなかったため、歌手を対応付けられませんでした。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A canção não foi encontrada no Genius, por isso não foi possível associar os seus cantores."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låten hittades inte på Genius, så dess sångare kunde inte matchas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Genius 上未找到该歌曲,因此无法匹配其演唱者。"
          }
        }
      }
    },
    "That take was too short or silent to keep." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aufnahme war zu kurz oder zu leise, um sie zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa grabación fue demasiado corta o demasiado suave para conservarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette prise était trop courte ou silencieuse pour être conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella registrazione era troppo breve o troppo bassa per essere conservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その録音は短すぎるか音が小さすぎて、残せませんでした。"
