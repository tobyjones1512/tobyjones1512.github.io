    "Double-tap Apple Pencil to switch to the eraser and back. Undo and Redo are at the top right of this panel." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe zweimal auf den Apple Pencil, um zum Radierer und zurück zu wechseln. Widerrufen und Wiederholen findest du oben rechts in diesem Bereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces el Apple Pencil para cambiar a la goma y volver. Deshacer y Rehacer están arriba a la derecha de este panel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois l'Apple Pencil pour passer à la gomme et revenir. Annuler et Rétablir se trouvent en haut à droite de ce panneau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte Apple Pencil per passare alla gomma e tornare indietro. Annulla e Ripeti sono in alto a destra in questo pannello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pencilをダブルタップすると消しゴムに切り替わり、もう一度で戻ります。「取り消す」と「やり直す」はこのパネルの右上にあります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca duas vezes no Apple Pencil para mudar para a borracha e voltar. Anular e Refazer estão no canto superior direito deste painel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltryck på Apple Pencil för att växla till suddgummit och tillbaka. Ångra och Gör om finns uppe till höger i den här panelen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连按两下 Apple Pencil 可切换到橡皮擦，再连按可切回。“还原”和“重做”位于此面板右上角。"
          }
        }
      }
    },
