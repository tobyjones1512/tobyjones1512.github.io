    "Bar %lld: 1st/2nd time bars (Bracket Longer stretches one over the next bar), jumps, or a tempo mark." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takt %lld: 1.- und 2.-Mal-Klammern (Klammer verlängern dehnt sie über den nächsten Takt), Sprünge oder eine Tempomarkierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compás %lld: casillas de 1.ª y 2.ª vez (Alargar casilla la extiende al compás siguiente), saltos o una indicación de tempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure %lld : mesures à 1re/2e fois (Rallonger la prolonge sur la mesure suivante), sauts ou indication de tempo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battuta %lld: parentesi di 1ª e 2ª volta (Allunga parentesi la estende alla battuta successiva), salti o un'indicazione di tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 小節:1番・2番カッコ(カッコを延長で次の小節まで伸ばせます)、ジャンプ、テンポ記号。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compasso %lld: casas de 1.ª e 2.ª vez (Prolongar casa estende-a ao compasso seguinte), saltos ou uma indicação de andamento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takt %lld: 1:a och 2:a gången-klamrar (Förläng klammer drar den över nästa takt), hopp eller en tempoangivelse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 %lld 小节:第一次和第二次结尾括号(延长括号可延伸到下一小节)、跳转或速度标记。"
          }
        }
      }
    },
    "Bar %lld: add repeat signs, or insert or delete the bar." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
