    "Bars: repeat signs, and adding or deleting a bar. Expand Repeats writes the piece out as it is played." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takte: Wiederholungszeichen sowie Takt hinzufügen oder löschen. Wiederholungen ausschreiben schreibt das Stück so aus, wie es gespielt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compases: signos de repetición, y añadir o eliminar un compás. Desplegar repeticiones escribe la pieza tal como se toca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesures : signes de reprise, et ajout ou suppression d'une mesure. Développer les reprises écrit le morceau tel qu'il est joué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battute: segni di ritornello e aggiunta o eliminazione di una battuta. Espandi ritornelli scrive il brano così come viene suonato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小節:反復記号、小節の追加と削除。「反復を展開」は曲を実際に演奏される形に書き出します。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compassos: sinais de repetição, e adicionar ou eliminar um compasso. Expandir repetições escreve a peça tal como é tocada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takter: repristecken, och lägga till eller ta bort en takt. Skriv ut repriser skriver ut stycket som det spelas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小节:反复记号,以及添加或删除小节。“展开反复”会把乐曲按实际演奏的样子写出来。"
          }
        }
      }
    },
