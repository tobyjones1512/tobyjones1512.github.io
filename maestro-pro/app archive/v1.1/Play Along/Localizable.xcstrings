    "Read, rehearse, perform and write.\nSheet music timed to the note." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesen, proben, aufführen und schreiben.\nNoten, auf die Note genau getaktet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee, ensaya, actúa y escribe.\nPartituras sincronizadas con cada nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez, répétez, jouez et écrivez.\nDes partitions synchronisées à la note près."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi, prova, esegui e scrivi.\nSpartiti a tempo con ogni nota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読む、練習する、演奏する、書く。\n音符ひとつひとつに合う楽譜。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê, ensaia, atua e escreve.\nPartituras sincronizadas com cada nota."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läs, öva, uppträd och skriv.\nNoter, tidsatta till varje ton."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阅读、排练、演出与创作。\n乐谱精确到每个音符。"
          }
        }
      }
    },
    "Reading staves and notes…" : {
      "extractionState" : "manual",
      "localizations" : {
