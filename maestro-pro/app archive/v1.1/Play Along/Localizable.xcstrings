    "Needed for private repositories, for adding a lot of tracks, and for pushing a score's history to GitHub (then with read and write access to the repository's contents). It's kept in your Keychain." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nötig für private Repositories, zum Hinzufügen vieler Spuren und zum Übertragen des Verlaufs einer Partitur zu GitHub (dann mit Lese- und Schreibzugriff auf die Inhalte des Repositorys). Er wird in deinem Schlüsselbund gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesario para repositorios privados, para añadir muchas pistas y para enviar el historial de una partitura a GitHub (con acceso de lectura y escritura al contenido del repositorio). Se guarda en tu llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire pour les dépôts privés, pour ajouter beaucoup de pistes et pour envoyer l'historique d'une partition vers GitHub (avec accès en lecture et écriture au contenu du dépôt). Il est conservé dans votre trousseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessario per i repository privati, per aggiungere molte tracce e per inviare a GitHub la cronologia di uno spartito (allora con accesso in lettura e scrittura al contenuto del repository). Viene conservato nel Portachiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライベートリポジトリ、多数のトラックの追加、楽譜の履歴のGitHubへのプッシュ（リポジトリの内容への読み書き権限付き）に必要です。キーチェーンに保存されます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessário para repositórios privados, para adicionar muitas faixas e para enviar o histórico de uma partitura para o GitHub (então com acesso de leitura e escrita ao conteúdo do repositório). É guardado na tua Keychain."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behövs för privata arkiv, för att lägga till många spår och för att skicka ett notblads historik till GitHub (då med läs- och skrivbehörighet till arkivets innehåll). Den sparas i din nyckelring."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私有仓库、添加大量音轨以及将乐谱历史推送到 GitHub（需要对仓库内容的读写权限）时需要。它存放在你的钥匙串中。"
          }
        }
      }
    },
    "New Blank Score" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
