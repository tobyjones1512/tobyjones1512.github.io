    },
    "New Blank Score starts an empty score to write yourself: you choose the name, time signature, key, number of bars, staves (treble, bass or piano) and tempo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue leere Partitur beginnt eine leere Partitur zum Selbstschreiben: Du wählst Namen, Taktart, Tonart, Taktzahl, Notensysteme (Violin-, Bass- oder Klaviersystem) und Tempo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueva partitura en blanco empieza una partitura vacía para escribirla tú: eliges el nombre, el compás, la tonalidad, el número de compases, los pentagramas (clave de sol, clave de fa o piano) y el tempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouvelle partition vierge crée une partition vide à écrire vous-même : vous choisissez le nom, la signature rythmique, la tonalité, le nombre de mesures, les portées (clé de sol, clé de fa ou piano) et le tempo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuovo spartito vuoto avvia uno spartito vuoto da scrivere tu: scegli nome, tempo in chiave, tonalità, numero di battute, pentagrammi (violino, basso o pianoforte) e velocità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「新規の白紙の楽譜」は、自分で書くための空の楽譜を始めます。名前、拍子、キー、小節数、譜表(ト音、ヘ音、ピアノ)、テンポを選びます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova partitura em branco inicia uma partitura vazia para escrever você mesmo: escolhe o nome, o compasso, a tonalidade, o número de compassos, as pautas (clave de sol, clave de fá ou piano) e o andamento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny tom not startar en tom not att skriva själv: du väljer namn, taktart, tonart, antal takter, notsystem (diskant, bas eller piano) och tempo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“新建空白乐谱”会开始一份空白乐谱供你自己书写:你可选择名称、拍号、调、小节数、谱表(高音、低音或钢琴)和速度。"
          }
        }
      }
    },
