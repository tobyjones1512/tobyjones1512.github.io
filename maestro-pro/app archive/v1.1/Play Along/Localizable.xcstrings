    "Your library and annotations are never touched by a reset." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Bibliothek und Anmerkungen bleiben von einem Zurücksetzen unberührt."
