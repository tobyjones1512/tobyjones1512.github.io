    "Rhythm read from the note values in %lld of %lld bars. The rest (tuplets, unusual engraving) follow the printed spacing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rhythmus aus den Notenwerten in %1$lld von %2$lld Takten gelesen. Der Rest (Triolen, ungewöhnlicher Notensatz) folgt dem gedruckten Abstand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmo leído de los valores de nota en %1$lld de %2$lld compases. El resto (tresillos, grabado poco habitual) sigue el espaciado impreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rythme lu d'après les valeurs de notes dans %1$lld mesures sur %2$lld. Le reste (nolets, gravure inhabituelle) suit l'espacement imprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmo letto dai valori delle note in %1$lld battute su %2$lld. Il resto (terzine, incisione insolita) segue la spaziatura stampata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld小節中%1$lld小節の音価からリズムを読み取りました。残り（連符や特殊な浄書）は印刷された間隔に従います。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmo lido a partir dos valores das notas em %1$lld de %2$lld compassos. O resto (quiálteras, gravação invulgar) segue o espaçamento impresso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytmen lästes från notvärdena i %1$lld av %2$lld takter. Resten (triol, ovanlig notsättning) följer det tryckta avståndet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已根据 %2$lld 个小节中 %1$lld 个小节的音符时值读取节奏。其余部分（连音、特殊排版）按印刷间距处理。"
          }
        }
      }
    },
