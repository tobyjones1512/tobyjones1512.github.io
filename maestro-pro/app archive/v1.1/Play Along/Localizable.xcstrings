    "%lld of the %lld bars of “%@” go in after the bar you have chosen, or at the end if none is chosen. They keep their own metre and tempo, and your music takes its own back after them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld der %2$lld Takte von „%3$@“ werden nach dem gewählten Takt eingefügt, oder am Ende, falls keiner gewählt ist. Sie behalten ihre eigene Taktart und ihr Tempo, danach übernimmt deine Musik wieder ihr eigenes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de los %2$lld compases de «%3$@» se insertan después del compás elegido, o al final si no hay ninguno. Conservan su propio compás y tempo, y tu música recupera los suyos después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld des %2$lld mesures de « %3$@ » sont insérées après la mesure choisie, ou à la fin si aucune n'est choisie. Elles gardent leur propre métrique et leur tempo, puis votre musique reprend le sien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld delle %2$lld battute di «%3$@» vengono inserite dopo la battuta scelta, o alla fine se non ne è scelta nessuna. Mantengono il proprio tempo e metronomo, e la tua musica riprende i suoi dopo di esse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%3$@」の%2$lld小節のうち%1$lld小節が、選んだ小節の後ろ（未選択の場合は最後）に入ります。それぞれの拍子とテンポはそのままで、その後はあなたの音楽のものに戻ります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld dos %2$lld compassos de «%3$@» entram depois do compasso escolhido, ou no fim se nenhum estiver escolhido. Mantêm o seu próprio compasso e andamento, e a tua música retoma os dela depois."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld av de %2$lld takterna i ”%3$@” sätts in efter den valda takten, eller i slutet om ingen är vald. De behåller sin egen taktart och sitt eget tempo, och din musik tar tillbaka sina efteråt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%3$@”的 %2$lld 个小节中的 %1$lld 个会插入到所选小节之后；若未选择小节，则插入到末尾。它们保留各自的拍号和速度，之后你的音乐恢复自己的拍号和速度。"
          }
        }
      }
    },
    "%lld percent" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
