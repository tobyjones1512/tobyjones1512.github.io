    "Edit with Apple Pencil Only (Options) stops fingers from changing notes, so a hand resting on the page does no harm." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur mit Apple Pencil bearbeiten (Optionen) hindert Finger daran, Noten zu ändern, sodass eine aufliegende Hand keinen Schaden anrichtet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar solo con Apple Pencil (Opciones) impide que los dedos cambien notas, así que una mano apoyada en la página no causa daño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier avec l'Apple Pencil seulement (Options) empêche les doigts de changer les notes, pour qu'une main posée sur la page ne fasse aucun mal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica solo con Apple Pencil (Opzioni) impedisce alle dita di cambiare le note, così una mano appoggiata sulla pagina non fa danni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Apple Pencil のみで編集」(オプション)は、指で音符を変えないようにするので、手をページに置いても問題ありません。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar só com o Apple Pencil (Opções) impede os dedos de alterar notas, por isso uma mão pousada na página não faz mal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigera endast med Apple Pencil (Alternativ) hindrar fingrar från att ändra noter, så en hand som vilar på sidan gör ingen skada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“仅用 Apple Pencil 编辑”(选项)阻止手指更改音符,所以手搁在页面上也不会有影响。"
          }
        }
      }
    },
