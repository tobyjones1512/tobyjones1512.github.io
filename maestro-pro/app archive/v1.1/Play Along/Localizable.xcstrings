    "Practice Speed slows a piece down or speeds it up without changing the pitch. Type any percentage from 10 to 400 in the box, or use the slider (50 to 150)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übungstempo verlangsamt oder beschleunigt ein Stück, ohne die Tonhöhe zu ändern. Gib im Feld einen beliebigen Prozentwert von 10 bis 400 ein oder nutze den Regler (50 bis 150)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad de práctica ralentiza o acelera una pieza sin cambiar el tono. Escribe cualquier porcentaje de 10 a 400 en la casilla, o usa el control deslizante (50 a 150)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse d'entraînement ralentit ou accélère un morceau sans changer la hauteur. Saisissez n'importe quel pourcentage de 10 à 400 dans la case, ou utilisez le curseur (50 à 150)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità di studio rallenta o accelera un brano senza cambiare l'altezza. Scrivi qualsiasi percentuale da 10 a 400 nella casella, o usa il cursore (da 50 a 150)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「練習スピード」は、ピッチを変えずに曲を遅くしたり速くしたりします。ボックスに 10 から 400 までの任意の割合を入力するか、スライダ(50 から 150)を使います。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade de prática abranda ou acelera uma peça sem mudar a altura. Escreva qualquer percentagem de 10 a 400 na caixa, ou use o cursor (50 a 150)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Övningstempo saktar ner eller snabbar upp ett stycke utan att ändra tonhöjden. Skriv valfri procentsats från 10 till 400 i rutan, eller använd reglaget (50 till 150)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“练习速度”可在不改变音高的情况下放慢或加快乐曲。在输入框中键入 10 到 400 的任意百分比,或使用滑块(50 到 150)。"
          }
        }
      }
    },
