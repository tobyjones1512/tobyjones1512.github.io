    "Metre tells the app how many beats are in a bar. It is found automatically from MusicXML files; for PDFs the app asks when it cannot tell." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taktart sagt der App, wie viele Schläge ein Takt hat. Sie wird bei MusicXML-Dateien automatisch gefunden; bei PDFs fragt die App, wenn sie es nicht erkennen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compás le dice a la app cuántos pulsos hay en un compás. Se encuentra automáticamente en los archivos MusicXML; en los PDF la app pregunta cuando no puede saberlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure indique à l'app combien de temps il y a dans une mesure. Elle est trouvée automatiquement pour les fichiers MusicXML ; pour les PDF, l'app demande quand elle ne peut pas la déterminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo in chiave dice all'app quanti movimenti ci sono in una battuta. Viene trovato automaticamente dai file MusicXML; per i PDF l'app chiede quando non riesce a capirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「拍子」は、1小節に何拍あるかをアプリに伝えます。MusicXML ファイルでは自動で見つかり、PDF では判断できないときにアプリが尋ねます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compasso diz à app quantos tempos há num compasso. É encontrado automaticamente nos ficheiros MusicXML; nos PDF a app pergunta quando não consegue saber."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taktart talar om för appen hur många slag det är i en takt. Den hittas automatiskt från MusicXML-filer; för PDF:er frågar appen när den inte kan avgöra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“拍号”告诉 App 一个小节有几拍。MusicXML 文件会自动识别;PDF 在无法判断时 App 会询问。"
          }
        }
      }
    },
