    " Free Editing is on: nothing is corrected, and touching empty space in a bar adds a note after the last one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Freies Bearbeiten ist an: Nichts wird korrigiert, und ein Tippen auf leere Fläche in einem Takt fügt eine Note nach der letzten hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " La edición libre está activada: no se corrige nada, y al tocar un espacio vacío de un compás se añade una nota después de la última."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " La modification libre est activée : rien n’est corrigé, et toucher un espace vide dans une mesure ajoute une note après la dernière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " La modifica libera è attiva: nulla viene corretto e toccando uno spazio vuoto di una battuta si aggiunge una nota dopo l'ultima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 自由編集がオンです。何も自動修正されず、小節の空白部分をタップすると最後の音符のあとに音符が追加されます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " A edição livre está ativada: nada é corrigido, e tocar num espaço vazio de um compasso acrescenta uma nota depois da última."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Fri redigering är på: inget rättas, och ett tryck på tomt utrymme i en takt lägger till en not efter den sista."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 自由编辑已开启:不会自动纠正任何内容,点按小节的空白处会在最后一个音符之后添加一个音符。"
          }
        }
      }
    },
    " The backing track is pitch-shifted to match." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Das Playback wird passend umgestimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " El acompañamiento se afinará para coincidir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " La piste d’accompagnement est transposée pour correspondre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " La base verrà accordata di conseguenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " バッキングもそれに合わせてチューニングされます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " O acompanhamento será afinado para combinar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Kompet stäms om så att det passar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 伴奏会相应调音。"
          }
        }
      }
    },
    " The backing track stays in its recorded key." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Das Playback bleibt in seiner aufgenommenen Tonart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " El acompañamiento se queda en su tonalidad grabada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " La piste d’accompagnement reste dans sa tonalité d’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " La base resta nella tonalità registrata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " バッキングは録音されたキーのままです。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " O acompanhamento mantém a tonalidade em que foi gravado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Kompet behåller sin inspelade tonart."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 伴奏保持录制时的调。"
          }
        }
      }
    },
    " You can change this any time in the Inspector." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Du kannst das jederzeit im Informationsbereich ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Puedes cambiarlo cuando quieras en el panel de información."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Vous pourrez le modifier à tout moment dans l’inspecteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Puoi cambiarlo in qualsiasi momento nel pannello informazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " インフォメーションパネルでいつでも変更できます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Pode alterá-lo a qualquer momento no painel de informação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Du kan ändra detta när som helst i informationspanelen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 你可以随时在信息面板中更改。"
          }
        }
      }
    },
    ", already the score’s key" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", schon die Tonart der Partitur"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", que ya es la tonalidad de la partitura"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", déjà la tonalité de la partition"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", che è già la tonalità dello spartito"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "、楽譜のキーと同じです"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", que já é a tonalidade da partitura"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", som redan är notens tonart"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ",即乐谱本来的调"
          }
        }
      }
    },
    ", so the score moves down %lld semitones" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", daher wandert die Partitur %lld Halbtöne nach unten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", así que la partitura baja %lld semitonos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", la partition descend donc de %lld demi-tons"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", quindi lo spartito scende di %lld semitoni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "、楽譜は %lld 半音下がります"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", pelo que a partitura desce %lld meios-tons"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", så noten flyttas ner %lld halvtoner"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ",因此乐谱下移 %lld 个半音"
          }
        }
      }
    },
    ", so the score moves down 1 semitone" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", daher wandert die Partitur einen Halbton nach unten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", así que la partitura baja un semitono"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", la partition descend donc d’un demi-ton"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", quindi lo spartito scende di un semitono"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "、楽譜は 1 半音下がります"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", pelo que a partitura desce um meio-tom"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", så noten flyttas ner en halvton"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ",因此乐谱下移一个半音"
          }
        }
      }
    },
