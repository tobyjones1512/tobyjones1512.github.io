    "Share with Another Player (Advanced mode, same menu) makes a .maestropro file with the score and its backing track for another Maestro Pro user." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit anderem Spieler teilen (erweiterter Modus, dasselbe Menü) erzeugt eine .maestropro-Datei mit der Partitur und ihrem Playback für einen anderen Maestro-Pro-Nutzer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir con otro músico (modo Avanzado, mismo menú) crea un archivo .maestropro con la partitura y su acompañamiento para otro usuario de Maestro Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partager avec un autre musicien (mode Avancé, même menu) crée un fichier .maestropro avec la partition et son accompagnement pour un autre utilisateur de Maestro Pro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi con un altro musicista (modalità Avanzata, stesso menu) crea un file .maestropro con lo spartito e la sua base per un altro utente di Maestro Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ほかの演奏者と共有」(上級モード、同じメニュー)は、別の Maestro Pro ユーザー向けに、楽譜とそのバッキングを含む .maestropro ファイルを作ります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partilhar com outro músico (modo Avançado, mesmo menu) cria um ficheiro .maestropro com a partitura e o seu acompanhamento para outro utilizador do Maestro Pro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela med annan spelare (avancerat läge, samma meny) skapar en .maestropro-fil med noten och dess komp åt en annan Maestro Pro-användare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“与其他演奏者分享”(高级模式,同一菜单)会生成一个带有乐谱及其伴奏的 .maestropro 文件,供另一位 Maestro Pro 用户使用。"
          }
        }
      }
    },
    "Share with Another Player makes a .maestropro file that carries the score and its backing track. Another Maestro Pro user who opens it gets all of it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit anderem Spieler teilen erzeugt eine .maestropro-Datei, die die Partitur und ihr Playback enthält. Ein anderer Maestro-Pro-Nutzer, der sie öffnet, bekommt alles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir con otro músico crea un archivo .maestropro que lleva la partitura y su acompañamiento. Otro usuario de Maestro Pro que lo abra lo recibe todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partager avec un autre musicien crée un fichier .maestropro qui contient la partition et son accompagnement. Un autre utilisateur de Maestro Pro qui l'ouvre obtient tout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi con un altro musicista crea un file .maestropro che contiene lo spartito e la sua base. Un altro utente di Maestro Pro che lo apre ottiene tutto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ほかの演奏者と共有」は、楽譜とそのバッキングを含む .maestropro ファイルを作ります。別の Maestro Pro ユーザーが開くと、すべてが手に入ります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partilhar com outro músico cria um ficheiro .maestropro que leva a partitura e o seu acompanhamento. Outro utilizador do Maestro Pro que o abra fica com tudo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela med annan spelare skapar en .maestropro-fil som bär noten och dess komp. En annan Maestro Pro-användare som öppnar den får allt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“与其他演奏者分享”会生成一个携带乐谱及其伴奏的 .maestropro 文件。另一位 Maestro Pro 用户打开后会得到全部内容。"
          }
        }
      }
    },
