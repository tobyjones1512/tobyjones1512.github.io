          }
        }
      }
    },
    "The microphone can hear the backing track. Mute it or use headphones." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon hört das Playback. Schalte es stumm oder nutze Kopfhörer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono oye la pista de acompañamiento. Silénciala o usa auriculares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro entend l'accompagnement. Coupez-le ou utilisez un casque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il microfono sente la base. Silenziala o usa le cuffie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクがバッキングトラックを拾います。ミュートするかヘッドホンを使ってください。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone consegue ouvir o acompanhamento. Silencia-o ou usa auscultadores."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen hör kompspåret. Stäng av ljudet eller använd hörlurar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风能听到伴奏。请将它静音或使用耳机。"
          }
        }
      }
    },
    "The microphone couldn’t be started." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon konnte nicht gestartet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo iniciar el micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de démarrer le micro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile avviare il microfono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクを起動できませんでした。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar o microfone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att starta mikrofonen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法启动麦克风。"
          }
        }
      }
    },
    "The microphone hears everything the speaker plays, so the backing track would be recorded and judged as if you had played it. Mute it for this recording (it comes back afterwards), or use headphones." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon hört alles, was der Lautsprecher spielt, daher würde das Playback aufgenommen und bewertet, als hättest du es gespielt. Schalte es für diese Aufnahme stumm (danach ist es wieder da) oder nutze Kopfhörer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono oye todo lo que reproduce el altavoz, así que la pista de acompañamiento se grabaría y se evaluaría como si la hubieras tocado tú. Silénciala en esta grabación (vuelve después) o usa auriculares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro entend tout ce que joue le haut-parleur : l'accompagnement serait donc enregistré et jugé comme si vous l'aviez joué. Coupez-le pour cet enregistrement (il revient ensuite) ou utilisez un casque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il microfono sente tutto ciò che suona l'altoparlante, quindi la base verrebbe registrata e valutata come se l'avessi suonata tu. Silenziala per questa registrazione (poi torna) oppure usa le cuffie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクはスピーカーから出るすべての音を拾うため、バッキングトラックが録音され、あなたが弾いたかのように判定されてしまいます。この録音ではミュートする（あとで元に戻ります）か、ヘッドホンを使ってください。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone ouve tudo o que a coluna toca, por isso o acompanhamento seria gravado e avaliado como se o tivesses tocado. Silencia-o nesta gravação (volta depois) ou usa auscultadores."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen hör allt som högtalaren spelar, så kompspåret skulle spelas in och bedömas som om du hade spelat det. Stäng av ljudet för den här inspelningen (det kommer tillbaka efteråt), eller använd hörlurar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风会听到扬声器播放的一切，因此伴奏会被录下并像是你弹奏的一样被评判。请在本次录制中将它静音（之后会恢复），或使用耳机。"
          }
        }
      }
    },
    "The moving line" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
