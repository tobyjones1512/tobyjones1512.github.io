    "Optional. Your own recording, synced to the score's tempo and key." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Deine eigene Aufnahme, abgestimmt auf Tempo und Tonart der Partitur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Tu propia grabación, ajustada al tempo y la tonalidad de la partitura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Votre propre enregistrement, synchronisé avec le tempo et la tonalité de la partition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. La tua registrazione, allineata al tempo e alla tonalità dello spartito."
          }
        },
        "ja" : {
          "stringUnit" : {
