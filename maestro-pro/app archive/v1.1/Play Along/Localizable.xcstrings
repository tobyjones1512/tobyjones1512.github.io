    "This sets the opening tempo; the score’s marks change it from there." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das legt das Anfangstempo fest; die Markierungen der Partitur ändern es von da an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto fija el tempo inicial; las marcas de la partitura lo cambian a partir de ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Règle le tempo initial ; les marques de la partition le modifient ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo imposta il tempo iniziale; i segni dello spartito lo cambiano da lì in poi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のテンポを設定します。以降は楽譜のマークが変更します。"
