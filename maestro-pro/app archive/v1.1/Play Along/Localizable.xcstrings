    "Follow Playback scrolls the page for you. Dark Sheet Music shows white music on black, kinder in a dim room." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabe folgen scrollt die Seite für dich. Dunkle Noten zeigt weiße Musik auf Schwarz, angenehmer in einem dunklen Raum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir reproducción desplaza la página por ti. Partitura oscura muestra la música en blanco sobre negro, más agradable en una sala con poca luz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivre la lecture fait défiler la page pour vous. Partition sombre affiche la musique en blanc sur noir, plus agréable dans une pièce sombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui riproduzione scorre la pagina per te. Spartito scuro mostra la musica in bianco su nero, più riposante in una stanza poco illuminata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「再生に追従」はページを自動でスクロールします。「ダーク楽譜」は黒地に白で楽譜を表示し、暗い部屋でやさしくなります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir reprodução desloca a página por si. Partitura escura mostra música branca sobre preto, mais agradável numa sala com pouca luz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följ uppspelning rullar sidan åt dig. Mörk notbild visar vit musik på svart, skonsammare i ett dunkelt rum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“跟随播放”会替你滚动页面。“深色乐谱”以黑底白字显示乐谱,在昏暗的房间里更柔和。"
          }
        }
      }
    },
