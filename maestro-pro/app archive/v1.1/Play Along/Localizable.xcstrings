    },
    "An overfull bar in the editor: turn Free Editing off, or delete a note and the editor will tidy the bar." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein überfüllter Takt im Editor: Schalte Freies Bearbeiten aus oder lösche eine Note, und der Editor räumt den Takt auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compás desbordado en el editor: desactiva Edición libre, o elimina una nota y el editor ordenará el compás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mesure surchargée dans l'éditeur : désactivez Modification libre, ou supprimez une note et l'éditeur rangera la mesure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una battuta troppo piena nell'editor: disattiva Modifica libera, oppure elimina una nota e l'editor riordina la battuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタで小節が詰め込まれすぎ:「自由編集」をオフにするか、音符を削除すると、エディタが小節を整えます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um compasso sobrecarregado no editor: desligue Edição livre, ou elimine uma nota e o editor arruma o compasso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En överfull takt i redigeraren: stäng av Fri redigering, eller ta bort en not så städar redigeraren takten."
