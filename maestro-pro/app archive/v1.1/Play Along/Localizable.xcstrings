    "Lyrics can go with a score or stand alone; a karaoke file plays as its own item." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte können zu einer Partitur gehören oder allein stehen; eine Karaoke-Datei läuft als eigener Eintrag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las letras pueden pertenecer a una partitura o ir solas; un archivo de karaoke se abre como entrada propia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paroles peuvent accompagner une partition ou exister seules ; un fichier karaoké se lit comme un élément à part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I testi possono appartenere a uno spartito o stare da soli; un file karaoke si apre come voce a sé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌詞は楽譜に付けても単独でも使えます。カラオケファイルは独立した項目として開きます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As letras podem pertencer a uma partitura ou estar sozinhas; um ficheiro de karaoke abre como entrada própria."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sångtexter kan höra till en not eller stå ensamma; en karaokefil öppnas som en egen post."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌词可以属于某份乐谱,也可以单独存在;卡拉OK文件会作为独立条目打开。"
          }
        }
      }
    },
