    "Sharp, Flat and Natural set an accidental on the selected note; Key returns it to what the key signature says." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreuz, B und Auflösung setzen ein Vorzeichen auf die gewählte Note; Tonart setzt sie auf das zurück, was die Vorzeichnung sagt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostenido, Bemol y Becuadro ponen una alteración en la nota seleccionada; Tonalidad la devuelve a lo que dice la armadura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dièse, Bémol et Bécarre posent une altération sur la note sélectionnée ; Tonalité la remet à ce que dit l'armure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesis, Bemolle e Bequadro mettono un'alterazione sulla nota selezionata; Tonalità la riporta a ciò che dice l'armatura di chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「シャープ」「フラット」「ナチュラル」は選んだ音符に臨時記号を付けます。「キー」は調号が示すものに戻します。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustenido, Bemol e Bequadro põem um acidente na nota selecionada; Tonalidade repõe-na no que diz a armadura de clave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kors, B och Återställning sätter ett förtecken på den valda noten; Tonart återställer den till vad förtecknet säger."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“升号”“降号”和“还原号”给所选音符设置变音记号;“调”让它恢复为调号所规定的。"
          }
        }
      }
    },
