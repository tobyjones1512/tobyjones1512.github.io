    "Lyrics scroll in time with the music like in Apple Music, and CD+Graphics karaoke files show their built-in pictures." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte scrollen im Takt der Musik wie in Apple Music, und CD+Graphics-Karaokedateien zeigen ihre eingebauten Bilder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las letras se desplazan al compás de la música como en Apple Music, y los archivos de karaoke CD+Graphics muestran sus imágenes integradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paroles défilent en rythme avec la musique comme dans Apple Music, et les fichiers karaoké CD+Graphics montrent leurs images intégrées."
