    "Cancel any time in your Apple Account settings. Subscriptions renew automatically unless cancelled at least 24 hours before the period ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jederzeit in den Einstellungen deines Apple-Kontos kündbar. Abos verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Ende des Zeitraums gekündigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela cuando quieras en los ajustes de tu cuenta de Apple. Las suscripciones se renuevan automáticamente salvo que se cancelen al menos 24 horas antes de que acabe el periodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résiliez à tout moment dans les réglages de votre compte Apple. Les abonnements se renouvellent automatiquement sauf annulation au moins 24 heures avant la fin de la période."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla in qualsiasi momento nelle impostazioni del tuo account Apple. Gli abbonamenti si rinnovano automaticamente a meno che non vengano annullati almeno 24 ore prima della fine del periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleアカウントの設定からいつでもキャンセルできます。期間終了の24時間前までにキャンセルしない限り、サブスクリプションは自動的に更新されます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela quando quiseres nas definições da tua conta Apple. As subscrições renovam automaticamente, a menos que sejam canceladas pelo menos 24 horas antes do fim do período."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avbryt när som helst i inställningarna för ditt Apple-konto. Prenumerationer förnyas automatiskt om de inte avbryts minst 24 timmar innan perioden slutar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可随时在 Apple 账户设置中取消。除非在当前周期结束前至少 24 小时取消，否则订阅会自动续订。"
          }
        }
      }
    },
