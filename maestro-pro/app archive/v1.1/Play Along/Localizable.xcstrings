    "Import Folder reads every supported file in a folder, pairing scores with a recording and lyrics of the same name." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner importieren liest jede unterstützte Datei in einem Ordner und ordnet Partituren eine Aufnahme und Texte mit demselben Namen zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importar carpeta lee cada archivo compatible de una carpeta y empareja las partituras con una grabación y letras del mismo nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importer un dossier lit tous les fichiers pris en charge d’un dossier, en associant les partitions à un enregistrement et à des paroles du même nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa cartella legge ogni file supportato in una cartella e abbina agli spartiti una registrazione e dei testi con lo stesso nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダを読み込むは、フォルダ内の対応するファイルをすべて読み取り、同じ名前の録音と歌詞を楽譜に結び付けます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importar pasta lê todos os ficheiros suportados numa pasta e associa as partituras a uma gravação e a letras com o mesmo nome."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importera mapp läser varje fil som stöds i en mapp och matchar noter med en inspelning och sångtexter med samma namn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入文件夹会读取文件夹中每个受支持的文件,并把同名的录音和歌词匹配给乐谱。"
          }
        }
      }
    },
    "Import Folder reads every supported file in a folder. In Settings, Link a Folder keeps a folder in step with the library so new files appear by themselves." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner importieren liest jede unterstützte Datei in einem Ordner. In den Einstellungen hält Ordner verknüpfen einen Ordner mit der Bibliothek im Gleichschritt, sodass neue Dateien von selbst erscheinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importar carpeta lee todos los archivos compatibles de una carpeta. En Ajustes, Vincular una carpeta mantiene una carpeta al paso de la biblioteca para que los archivos nuevos aparezcan solos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importer un dossier lit tous les fichiers pris en charge d'un dossier. Dans les Réglages, Lier un dossier garde un dossier synchronisé avec la bibliothèque pour que les nouveaux fichiers apparaissent d'eux-mêmes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa cartella legge ogni file supportato in una cartella. Nelle Impostazioni, Collega una cartella mantiene una cartella allineata alla libreria così i nuovi file compaiono da soli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「フォルダを読み込む」は、フォルダ内の対応ファイルをすべて読み取ります。「設定」の「フォルダをリンク」は、フォルダをライブラリと同期させ、新しいファイルが自動で現れるようにします。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importar pasta lê todos os ficheiros suportados numa pasta. Nas Definições, Associar uma pasta mantém uma pasta em sintonia com a biblioteca para que os novos ficheiros apareçam sozinhos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importera mapp läser varje fil som stöds i en mapp. I Inställningar håller Länka en mapp en mapp i takt med biblioteket så att nya filer dyker upp av sig själva."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“导入文件夹”会读取文件夹中每个受支持的文件。在“设置”中,“关联文件夹”让文件夹与资料库保持同步,新文件会自动出现。"
          }
        }
      }
    },
