        }
      }
    },
    "Draw on the sheet music with Apple Pencil" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Apple Pencil auf die Noten zeichnen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja sobre la partitura con el Apple Pencil"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessiner sur la partition avec l'Apple Pencil"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna sullo spartito con Apple Pencil"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pencilで楽譜に描き込む"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhar na partitura com o Apple Pencil"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rita på noterna med Apple Pencil"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Apple Pencil 在乐谱上绘制"
          }
        }
      }
    },
    "Draw over the music with Apple Pencil and the pen, marker, pencil and colour tools. Your drawing stays on the sheet music, and shows when you play it. White works too. Use the eraser in the tool palette to rub it out." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichne mit dem Apple Pencil und den Werkzeugen Stift, Marker, Bleistift und Farbe auf die Noten. Deine Zeichnung bleibt auf dem Notenblatt und erscheint beim Spielen. Auch Weiß geht. Nutze den Radierer in der Werkzeugpalette, um sie zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja sobre la partitura con el Apple Pencil, con pluma, marcador, lápiz y color. Tu dibujo se queda en la hoja y aparece al tocar. También sirve el blanco. Usa la goma de la paleta de herramientas para quitarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessinez sur la musique avec l’Apple Pencil et les outils stylo, marqueur, crayon et couleur. Votre dessin reste sur la partition et s’affiche quand vous la jouez. Le blanc fonctionne aussi. Utilisez la gomme de la palette d’outils pour l’effacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna sullo spartito con Apple Pencil, con penna, evidenziatore, matita e colore. Il disegno resta sul foglio e appare mentre suoni. Va bene anche il bianco. Usa la gomma nella tavolozza degli strumenti per rimuoverlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pencil で楽譜に描けます。ペン、マーカー、鉛筆、色が使えます。描いたものは楽譜に残り、演奏中も表示されます。白も使えます。消すにはツールパレットの消しゴムを使います。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhe sobre a partitura com o Apple Pencil, com caneta, marcador, lápis e cor. O seu desenho fica na folha e aparece quando toca. O branco também serve. Use a borracha da paleta de ferramentas para o remover."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rita på noterna med Apple Pencil, med penna, märkpenna, blyerts och färg. Din teckning stannar på notbladet och syns när du spelar. Vitt går också bra. Använd suddgummit i verktygspaletten för att ta bort den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Apple Pencil 在乐谱上绘制,可用钢笔、记号笔、铅笔和颜色。绘制的内容会留在乐谱上,演奏时也会显示。白色也可以。用工具面板中的橡皮擦来移除。"
          }
        }
      }
    },
    "Draw with Apple Pencil using the tool palette; the ink stays on the page." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichne mit dem Apple Pencil über die Werkzeugpalette; die Tinte bleibt auf der Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja con el Apple Pencil desde la paleta de herramientas; la tinta se queda en la página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessinez avec l’Apple Pencil grâce à la palette d’outils ; l’encre reste sur la page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna con Apple Pencil dalla tavolozza degli strumenti; l'inchiostro resta sulla pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールパレットから Apple Pencil で描きます。インクはページに残ります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhe com o Apple Pencil a partir da paleta de ferramentas; a tinta fica na página."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rita med Apple Pencil från verktygspaletten; bläcket stannar på sidan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Apple Pencil 从工具面板绘制;墨迹会留在页面上。"
          }
        }
      }
    },
    "Draw: write over the music with Apple Pencil, with pen, marker, pencil and colour tools. The ink stays on the page." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnen: Schreibe mit dem Apple Pencil über die Musik, mit den Werkzeugen Stift, Marker, Bleistift und Farbe. Die Tinte bleibt auf der Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibujar: escribe sobre la música con el Apple Pencil, con las herramientas de pluma, marcador, lápiz y color. La tinta se queda en la página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessin : écrivez sur la musique avec l'Apple Pencil, avec les outils stylo, marqueur, crayon et couleur. L'encre reste sur la page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegno: scrivi sulla musica con Apple Pencil, con gli strumenti penna, evidenziatore, matita e colore. L'inchiostro resta sulla pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描画:Apple Pencil で、ペン、マーカー、鉛筆、色のツールを使って音楽の上に書き込みます。インクはページに残ります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhar: escreva sobre a música com o Apple Pencil, com as ferramentas de caneta, marcador, lápis e cor. A tinta fica na página."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rita: Skriv över musiken med Apple Pencil, med verktygen penna, märkpenna, blyerts och färg. Bläcket stannar på sidan."
