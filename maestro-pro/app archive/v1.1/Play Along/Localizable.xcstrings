    "Printed or scanned music. The notes are read from the page so it can be followed and played." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedruckte oder gescannte Noten. Die Noten werden von der Seite gelesen, damit sie verfolgt und gespielt werden können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partituras impresas o escaneadas. Las notas se leen de la página para poder seguirlas y reproducirlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musique imprimée ou numérisée. Les notes sont lues sur la page pour pouvoir être suivies et jouées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spartiti stampati o scansionati. Le note vengono lette dalla pagina così possono essere seguite e suonate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "印刷またはスキャンした楽譜。追従や再生ができるよう、ページから音符を読み取ります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partituras impressas ou digitalizadas. As notas são lidas da página para poderem ser acompanhadas e tocadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryckta eller skannade noter. Noterna läses från sidan så att de kan följas och spelas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "印刷或扫描的乐谱。音符从页面读取,以便跟随和播放。"
          }
        }
      }
    },
