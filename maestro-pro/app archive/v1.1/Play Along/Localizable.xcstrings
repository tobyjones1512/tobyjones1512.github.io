    "The karaoke music plays higher or lower." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karaoke-Musik klingt höher oder tiefer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La música de karaoke suena más aguda o más grave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musique du karaoké est jouée plus haut ou plus bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
