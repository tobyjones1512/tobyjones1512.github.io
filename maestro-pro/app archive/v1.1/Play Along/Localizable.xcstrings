    "Duplicate repeats the chosen bars straight after themselves. Cut is Copy followed by Delete; the last bar of a piece always stays." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplizieren wiederholt die gewählten Takte gleich nach sich selbst. Ausschneiden ist Kopieren gefolgt von Löschen; der letzte Takt eines Stücks bleibt immer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplicar repite los compases elegidos justo después de sí mismos. Cortar es Copiar seguido de Eliminar; el último compás de una pieza siempre permanece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dupliquer répète les mesures choisies juste après elles-mêmes. Couper est Copier suivi de Supprimer ; la dernière mesure d'un morceau reste toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplica ripete le battute scelte subito dopo se stesse. Taglia è Copia seguito da Elimina; l'ultima battuta di un brano resta sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「複製」は選んだ小節を、自分自身の直後に繰り返します。「カット」は「コピー」のあと「削除」で、曲の最後の小節は必ず残ります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplicar repete os compassos escolhidos logo a seguir a si próprios. Cortar é Copiar seguido de Eliminar; o último compasso de uma peça fica sempre."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplicera upprepar de valda takterna direkt efter sig själva. Klipp ut är Kopiera följt av Ta bort; sista takten i ett stycke finns alltid kvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“复制”把所选小节紧接在自身之后重复。“剪切”就是“拷贝”再“删除”;乐曲的最后一个小节始终保留。"
          }
        }
      }
    },
    "Dynamic" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamik"
          }
        },
        "es" : {
