    "Merge, Take Theirs Where They Clash" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusammenführen, bei Konflikten ihre übernehmen"
