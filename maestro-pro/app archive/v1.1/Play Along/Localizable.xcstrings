    "GitHub wouldn't let the token change this repository. It needs read and write access to the repository's contents." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub ließ nicht zu, dass das Token dieses Repository ändert. Es braucht Lese- und Schreibzugriff auf die Inhalte des Repositorys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub no permitió que el token modifique este repositorio. Necesita acceso de lectura y escritura al contenido del repositorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub n’a pas autorisé le jeton à modifier ce dépôt. Il lui faut un accès en lecture et en écriture au contenu du dépôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub non ha permesso al token di modificare questo repository. Servono accesso in lettura e scrittura ai contenuti del repository."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub がこのトークンによるこのリポジトリの変更を許可しませんでした。リポジトリのコンテンツへの読み取りと書き込みの権限が必要です。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GitHub não permitiu que o token altere este repositório. Precisa de acesso de leitura e escrita ao conteúdo do repositório."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub tillät inte att token ändrar det här arkivet. Den behöver läs- och skrivåtkomst till arkivets innehåll."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 不允许该令牌修改此仓库。它需要对仓库内容的读写权限。"
          }
        }
      }
    },
    "GitHub's limit for requests without a token has been reached. Add a token, or try again in an hour." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Limit von GitHub für Anfragen ohne Token ist erreicht. Füge ein Token hinzu oder versuche es in einer Stunde erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcanzó el límite de GitHub para solicitudes sin token. Añade un token o inténtalo de nuevo en una hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite de GitHub pour les requêtes sans jeton est atteinte. Ajoutez un jeton, ou réessayez dans une heure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stato raggiunto il limite di GitHub per le richieste senza token. Aggiungi un token o riprova tra un'ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンなしのリクエストに対する GitHub の上限に達しました。トークンを追加するか、1時間後にもう一度お試しください。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foi atingido o limite do GitHub para pedidos sem token. Adicione um token ou tente novamente dentro de uma hora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubs gräns för förfrågningar utan token är nådd. Lägg till en token eller försök igen om en timme."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已达到 GitHub 对无令牌请求的限制。请添加令牌,或一小时后重试。"
          }
        }
      }
    },
    "Give each staff its own instrument, for example Bass on the bass-clef staff. Staves left on Same as Above use the instrument chosen above." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib jedem Notensystem sein eigenes Instrument, zum Beispiel Bass für das Bassschlüssel-System. Systeme auf „Wie oben“ nutzen das oben gewählte Instrument."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da a cada pentagrama su propio instrumento, por ejemplo Bajo en el pentagrama de clave de fa. Los pentagramas en Igual que arriba usan el instrumento elegido arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez à chaque portée son propre instrument, par exemple la basse sur la portée en clé de fa. Les portées laissées sur « Comme ci-dessus » utilisent l'instrument choisi plus haut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai a ogni pentagramma il suo strumento, per esempio Basso sul pentagramma in chiave di basso. I pentagrammi su Come sopra usano lo strumento scelto sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各五線にそれぞれ楽器を割り当てます。たとえばヘ音記号の五線にはベースを。「上と同じ」の五線は上で選んだ楽器を使います。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dá a cada pauta o seu instrumento, por exemplo Baixo na pauta em clave de fá. As pautas em Igual ao anterior usam o instrumento escolhido acima."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge varje notsystem sitt eget instrument, till exempel Bas på notsystemet med basklav. System som lämnas på Samma som ovan använder instrumentet som valts ovan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每个谱表指定各自的乐器，例如为低音谱号谱表指定低音提琴。设为“与上方相同”的谱表使用上方所选的乐器。"
          }
        }
      }
    },
