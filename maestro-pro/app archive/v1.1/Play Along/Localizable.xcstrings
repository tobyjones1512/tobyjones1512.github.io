    "Import with Import Score, by dragging a file onto the window, or from the share sheet of another app." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere mit Partitur importieren, indem du eine Datei auf das Fenster ziehst oder über das Teilen-Menü einer anderen App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa con Importar partitura, arrastrando un archivo a la ventana o desde el menú Compartir de otra app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez avec Importer une partition, en faisant glisser un fichier sur la fenêtre, ou depuis la feuille de partage d’une autre app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa con Importa spartito, trascinando un file sulla finestra o dal menu Condividi di un'altra app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽譜を読み込む、ウインドウへのファイルのドラッグ、または他の App の共有メニューから読み込みます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe com Importar partitura, arrastando um ficheiro para a janela ou a partir do menu Partilhar de outra app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importera med Importera not, genom att dra en fil till fönstret eller från delningsmenyn i en annan app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“导入乐谱”,或把文件拖到窗口,或通过其他 App 的“分享”菜单导入。"
          }
        }
      }
    },
    "Imported scores appear here." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
