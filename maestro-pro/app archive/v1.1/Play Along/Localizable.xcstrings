    "Up to eight devices can join one session. The Nudge slider moves your sound earlier or later if you use wireless speakers or headphones." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu acht Geräte können einer Sitzung beitreten. Der Regler Versatz verschiebt deinen Ton früher oder später, wenn du kabellose Lautsprecher oder Kopfhörer nutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta ocho dispositivos pueden unirse a una sesión. El control Ajuste adelanta o retrasa tu sonido si usas altavoces o auriculares inalámbricos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu'à huit appareils peuvent rejoindre une session. Le curseur Décalage avance ou retarde votre son si vous utilisez des haut-parleurs ou un casque sans fil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino a otto dispositivi possono unirsi a una sessione. Il cursore Sfasamento sposta il tuo suono prima o dopo se usi altoparlanti o cuffie wireless."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つのセッションに最大8台まで参加できます。ワイヤレススピーカーやヘッドフォンを使う場合は、「ずらし」スライダで音を早めたり遅らせたりできます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até oito dispositivos podem entrar numa sessão. O cursor Ajuste adianta ou atrasa o seu som se usar altifalantes ou auscultadores sem fios."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upp till åtta enheter kan gå med i en session. Reglaget Förskjutning flyttar ditt ljud tidigare eller senare om du använder trådlösa högtalare eller hörlurar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个会话最多可加入八台设备。如果使用无线扬声器或耳机,“微调”滑块可让你的声音提前或延后。"
          }
        }
      }
    },
    "Up to eight devices running Maestro Pro can play in time with each other (Advanced mode)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu acht Geräte mit Maestro Pro können im Takt miteinander spielen (erweiterter Modus)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta ocho dispositivos con Maestro Pro pueden tocar al compás unos con otros (modo Avanzado)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu'à huit appareils exécutant Maestro Pro peuvent jouer en rythme les uns avec les autres (mode Avancé)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino a otto dispositivi con Maestro Pro possono suonare a tempo tra loro (modalità Avanzata)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maestro Pro を実行している最大8台のデバイスが、互いに合わせて演奏できます(上級モード)。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até oito dispositivos com o Maestro Pro podem tocar a tempo uns com os outros (modo Avançado)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upp till åtta enheter som kör Maestro Pro kan spela i takt med varandra (avancerat läge)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多八台运行 Maestro Pro 的设备可以彼此同步演奏(高级模式)。"
          }
        }
      }
    },
