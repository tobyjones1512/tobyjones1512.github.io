    },
    "Jazz tunes are downloaded when you add them, so you need to be online." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazz-Stücke werden beim Hinzufügen geladen, du musst also online sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las piezas de jazz se descargan al añadirlas, así que necesitas conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les morceaux de jazz sont téléchargés à l'ajout, vous devez donc être connecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I brani jazz vengono scaricati quando li aggiungi, quindi devi essere online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャズの曲は追加時にダウンロードされるため、オンラインである必要があります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os temas de jazz são transferidos quando os adicionas, por isso tens de estar online."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazzlåtar hämtas när du lägger till dem, så du måste vara online."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "爵士曲目在添加时下载，因此你需要联网。"
          }
        }
      }
    },
    "Jazz tunes need the internet the first time you add them." : {
