    "Their part has %lld bars and yours has %lld, so the two may drift apart." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Stimme hat %1$lld Takte und deine %2$lld, daher können beide auseinanderdriften."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su parte tiene %1$lld compases y la tuya %2$lld, así que pueden desfasarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leur partie compte %1$lld mesures et la vôtre %2$lld : les deux peuvent donc se décaler."
          }
        },
        "it" : {
          "stringUnit" : {
