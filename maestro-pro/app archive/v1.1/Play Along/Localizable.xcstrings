    "Maestro Pro shows the music in your instrument's key, so it matches the part in front of you." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maestro Pro zeigt die Musik in der Tonart deines Instruments, damit sie zur Stimme vor dir passt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maestro Pro muestra la música en la tonalidad de tu instrumento, para que coincida con la voz que tienes delante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maestro Pro affiche la musique dans la tonalité de votre instrument, pour qu’elle corresponde à la partie sous vos yeux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maestro Pro mostra la musica nella tonalità del tuo strumento, così corrisponde alla parte che hai davanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maestro Pro は、目の前のパートに合うよう、楽器のキーで音楽を表示します。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
