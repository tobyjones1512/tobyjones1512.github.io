    "The recording is pitch-shifted without changing its speed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme wird in der Tonhöhe verschoben, ohne ihre Geschwindigkeit zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación cambia de altura sin cambiar su velocidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement change de hauteur sans changer de vitesse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione cambia altezza senza cambiare velocità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音は速さを変えずに音程だけが変わります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação muda de altura sem alterar a velocidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspelningen ändrar tonhöjd utan att ändra hastighet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音在不改变速度的情况下升降音高。"
          }
        }
      }
    },
    "The score and its backing track, to share with another player." : {
      "extractionState" : "manual",
      "localizations" : {
